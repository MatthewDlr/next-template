{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "build",
    "coverage",
    "next-env.d.ts",
    ".env*.local"
  ],
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },
  "newlinesBetween": true,
  "sortPackageJson": {
    "sortScripts": true // Sort script alphabetically
  },
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "attributes": ["class", "className"],
    "functions": ["clsx", "cn", "cva", "tw"],
    "preserveWhitespace": true
  }
}
